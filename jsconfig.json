{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": false,
    "jsx": "preserve",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "index.html",
    "*.js",
    "server.py"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "cache",
    "__pycache__",
    ".github",
    "tests",
    "health.db",
    "health.db-shm",
    "health.db-wal"
  ]
}